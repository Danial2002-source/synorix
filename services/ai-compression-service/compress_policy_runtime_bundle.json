{
  "numeric_features": [
    "body_bytes",
    "rtt_ms",
    "ttfb_ms",
    "client_bw_mbps",
    "cpu_load",
    "queue_depth",
    "prior_compress_saving"
  ],
  "categorical_features": [
    "content_type",
    "cacheability_bucket",
    "proto"
  ],
  "bool_features": [
    "supports_gzip",
    "supports_zstd",
    "supports_br"
  ],
  "categorical_mappings": {
