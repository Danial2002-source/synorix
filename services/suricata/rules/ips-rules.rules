# Brute force detection: drops exactly once after 5+ POST /login from same IP in 5 min
# threshold type both = require count matches then suppress for the rest of the window
drop http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"SYNORIX IPS: Brute Force - 5+ Login Attempts Blocked"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/login"; nocase; threshold: type both, track by_src, count 5, seconds 300; classtype:attempted-dos; sid:10000701; rev:3; priority:1;)
drop http any any -> any any (msg:"SYNORIX IPS: Credential Stuffing - User Agent"; flow:to_server,established; content:"User-Agent:"; pcre:"/User-Agent:.*(curl|wget|python|java)/i"; classtype:attempted-user; sid:10000702; rev:1; priority:2;)
drop http any any -> any any (msg:"SYNORIX IPS: Password Spray - Common Passwords"; flow:to_server,established; content:"password="; pcre:"/password=(123456|password|admin)/i"; classtype:attempted-user; sid:10000703; rev:1; priority:2;)
drop http any any -> any any (msg:"SYNORIX IPS: JWT Manipulation - alg none"; flow:to_server,established; content:"|22|alg|22|:"; pcre:"/["]alg["]\s*:\s*["]none["]/i"; classtype:web-application-attack; sid:10000704; rev:1; priority:1;)
drop http any any -> any any (msg:"SYNORIX IPS: Session Fixation - PHPSESSID"; flow:to_server,established; content:"PHPSESSID"; pcre:"/PHPSESSID=/i"; classtype:web-application-attack; sid:10000705; rev:1; priority:2;)
drop http any any -> any any (msg:"SYNORIX IPS: OAuth Bypass - redirect_uri"; flow:to_server,established; content:"redirect_uri="; pcre:"/redirect_uri=.*@/i"; classtype:web-application-attack; sid:10000707; rev:1; priority:1;)
drop http any any -> any any (msg:"SYNORIX IPS: GraphQL Introspection"; flow:to_server,established; content:"__schema"; pcre:"/__schema|__type/i"; classtype:web-application-attack; sid:10000708; rev:1; priority:2;)
drop http any any -> any any (msg:"SYNORIX IPS: API - No Authorization Header"; flow:to_server,established; content:"/api/"; pcre:"/\/api\/.*POST/i"; classtype:web-application-attack; sid:10000709; rev:1; priority:2;)
drop http any any -> any any (msg:"SYNORIX IPS: Default Credentials - admin/admin"; flow:to_server,established; content:"username=admin"; pcre:"/username=admin.*password=admin/i"; classtype:attempted-admin; sid:10000710; rev:1; priority:1;)


