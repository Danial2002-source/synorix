# =============================================================================
# Synorix Security Proxy — Production Environment Variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared (used by both Go proxy and Node.js backend)
# -----------------------------------------------------------------------------

# Comma-separated list of origins allowed to make cross-origin requests.
# Must match the exact scheme+host+port of your frontend.
# Example: https://synorix.example.com
# No wildcards allowed in production.
ALLOWED_ORIGINS=https://synorix.vercel.app

# Shared secret token used for service-to-service calls (proxy ↔ backend,
# Suricata integration → backend, backend → proxy block-ip endpoint).
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Node.js Backend (server/index.js) — VM1, port 3001 (localhost only)
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=3001

# JWT signing secret — minimum 32 characters, ideally 64+.
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_openssl_rand_hex_64

# Bootstrap admin account — only needed on first run to create the admin user.
# REMOVE or set to false after the admin account is created.
ENABLE_BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_min12chars

# Set true ONLY if the backend itself is behind a self-signed cert in dev.
# Must NOT be set in production.
# ALLOW_INSECURE_BACKEND_TLS=false

# URL of the Go security proxy (called internally for auto-block feature).
# On VM1 this is localhost.
SECURITY_PROXY_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Go Security Proxy (security-proxy/main.go) — VM1, ports 8080 / 443
# -----------------------------------------------------------------------------

# Path to TLS certificate and private key files.
# Generate with: certbot or your CA, or for testing: mkcert
TLS_CERT=/etc/synorix/certs/fullchain.pem
TLS_KEY=/etc/synorix/certs/privkey.pem

# Set true to refuse startup if TLS cert/key are missing.
REQUIRE_TLS=true

# Set true to not start the plain HTTP listener (only HTTPS on 443).
DISABLE_HTTP=true

# URL of the Node.js backend (internal, not reachable from outside).
BACKEND_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Suricata Integration Service (suricata/integration/integration_service.py)
# — VM3, outbound only
# -----------------------------------------------------------------------------

# URL of the Synorix proxy on VM1 (reachable from VM3).
SYNORIX_PROXY_URL=https://your-domain.com

# Same token as above — used to authenticate alert/block requests to the proxy.
# INTERNAL_API_TOKEN=<same value as above>

# =============================================================================
# Firewall checklist
# =============================================================================
# VM1: ufw allow 443/tcp && ufw allow 8080/tcp
# VM1: ufw deny 3001/tcp   ← backend must NOT be publicly reachable
# VM3: outbound to VM1:8080 or VM1:443 only
# =============================================================================
